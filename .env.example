# ---------------------------------------------------------------------------
# PulseWatch environment template. Copy to .env for local development.
# Never commit real credentials. Values below are placeholders only.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Neon PostgreSQL: pooled URL for the API runtime, direct URL for migrations.
# Example shape (placeholders):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true
# DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://pulsewatch_user:replace_me@example-pooler.neon.tech/pulsewatch?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://pulsewatch_user:replace_me@example.neon.tech/pulsewatch?sslmode=require

# Redis-compatible Render Key Value internal URL.
REDIS_URL=redis://default:replace_me@example.internal:6379

# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
# Generate with: openssl rand -base64 32
MONITOR_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# Exact public frontend origin. Comma-separated origins are supported.
FRONTEND_ORIGIN=http://localhost:3000

# Frontend build-time API URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Integration/e2e tests only. The database name MUST end in _test.
# TEST_DATABASE_URL=postgresql://pulsewatch_user:replace_me@example.neon.tech/pulsewatch_test?sslmode=require
# TEST_DIRECT_URL=postgresql://pulsewatch_user:replace_me@example.neon.tech/pulsewatch_test?sslmode=require
